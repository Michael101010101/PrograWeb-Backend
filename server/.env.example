
PORT=3000

# Base de datos PostgreSQL (la usan Sequelize y sequelize-cli)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tfc
DB_USER=postgres
DB_PASS=
DB_SSL=false

# Sesión (JWT)
JWT_SECRET=grupo2prograweb123
JWT_EXPIRA=8h

# URL del front (CORS y enlaces de los correos)
CLIENT_URL=http://localhost:5173

# Solo en desarrollo: devuelve los enlaces de verificación y recuperación en la respuesta
# para poder probar sin correo. En producción debe ser false.
EXPONER_ENLACES=true

# Correo (opcional). Si no se completa, los correos se muestran en la consola del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Oficina TFC · ULIMA <tfc@ulima.edu.pe>"
